{
  "name": "gcake-dev",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "test:subscriptions": "pnpm build && node --import tsx --test test/subscription.test.ts",
    "dev": "astro dev",
    "build": "pnpm content:validate && astro build",
    "build:astro": "pnpm content:validate && astro build",
    "build:admin": "pnpm --filter @gcake/admin build",
    "build:worker": "pnpm --filter @gcake/admin-worker build",
    "build:workspaces": "pnpm --filter \"./apps/**\" --filter \"./packages/**\" build",
    "build:all": "pnpm build:astro && pnpm build:workspaces",
    "preview": "astro preview",
    "check": "astro check",
    "content:validate": "node --import tsx scripts/content/validate-series.ts",
    "content:sync:ithome": "node --import tsx scripts/external/sync-ithome-2026.ts",
    "preview:spike": "node --import tsx scripts/preview/feasibility-spike.ts",
    "slug:dev": "pnpm --filter @gcake/slug-generator dev",
    "test:public": "node --import tsx --test src/data/external/ithome-2026-topics.test.ts src/lib/content/publication.test.ts src/lib/content/local-posts.test.ts src/lib/seo/structured-data.test.ts src/lib/publishing/publication-transform.test.ts src/lib/publishing/adapters.test.ts scripts/publishing/release-orchestrate.test.ts scripts/external/ithome-sync.test.ts src/lib/publishing/release-queue.test.ts src/lib/publishing/release-eligibility.test.ts scripts/publishing/prepare-distribution.test.ts test/pages-scheduled-deployment.test.ts scripts/external/completed-restoration.test.ts",
    "test:workspaces": "pnpm --filter \"./apps/**\" --filter \"./packages/**\" test",
    "test": "pnpm test:editorial && pnpm test:hermes && pnpm test:public && node --import tsx --test scripts/workspace/foundation.test.ts scripts/workspace/public-visibility.test.ts && pnpm test:workspaces && pnpm test:distribution && pnpm test:observability",
    "test:hermes": "python3 -m unittest discover -s scripts/hermes -p \"test_*.py\"",
    "release:dry-run": "node --import tsx scripts/publishing/release-dry-run.ts",
    "distribution:run": "node --import tsx scripts/publishing/run-distribution.ts",
    "test:distribution": "node --import tsx --test scripts/publishing/distribution*.test.ts scripts/publishing/substack-browser.test.ts",
    "distribution:schedule-plan": "node --import tsx scripts/publishing/schedule-distribution.ts",
    "test:editorial": "node --import tsx --test src/lib/publishing/release-queue.test.ts scripts/publishing/editorial-release.test.ts scripts/publishing/deployment-rehearsal.test.ts scripts/publishing/unattended-check.test.ts",
    "editorial:unattended:check": "node --import tsx scripts/publishing/unattended-check.ts",
    "editorial:release": "node --import tsx scripts/publishing/editorial-release.ts",
    "editorial:rehearse": "node --import tsx scripts/publishing/rehearse-editorial.ts",
    "distribution:inventory": "node --import tsx scripts/publishing/distribution-inventory.ts",
    "distribution:all-plan": "node --import tsx scripts/publishing/plan-all-distribution.ts",
    "distribution:snapshot": "node --import tsx scripts/publishing/snapshot-distribution.ts",
    "distribution:sync": "node --import tsx scripts/publishing/sync-distribution.ts",
    "distribution:handoff": "node --import tsx scripts/publishing/distribution-handoff.ts",
    "test:observability": "node --import tsx --test test/website-observability.test.ts",
    "content:restore:ithome": "node --import tsx scripts/external/restore-completed-ithome-2026.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/vue": "^7.0.3",
    "astro": "^7.2.9",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.13",
    "vue": "^3.5.21",
    "yaml": "^2.8.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "linkedom": "0.18.12",
    "playwright": "1.58.2"
  }
}
