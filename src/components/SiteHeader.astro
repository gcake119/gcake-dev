---
import { site } from '@/data/site';
import Icon from './Icon.astro';
const pathname = Astro.url.pathname;
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href={`${site.basePath}/`} aria-label="首頁" title="返回首頁"><Icon name="home" /></a>
    <nav class="site-nav" aria-label="主要導覽">
      <a href={`${site.basePath}/series/`} aria-current={pathname.includes('/series/') ? 'page' : undefined}><Icon name="book" /><span>系列文章</span></a>
      <a href={`${site.basePath}/about/`} aria-current={pathname.includes('/about/') ? 'page' : undefined}><Icon name="user" /><span>關於</span></a>
      <button class="theme-toggle" type="button" aria-label="切換明暗主題" title="切換明暗主題"><Icon name="sun" /><Icon name="moon" /></button>
    </nav>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const storedTheme = () => { try { return localStorage.getItem('gcake-theme'); } catch { return null; } };
  const update = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    if (!button) return;
    button.setAttribute('aria-label', dark ? '切換至明亮主題' : '切換至暗色主題');
    button.title = dark ? '切換至明亮主題' : '切換至暗色主題';
  };
  update();
  button?.addEventListener('click', () => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem('gcake-theme', theme); } catch { /* Theme still works without storage. */ }
    update();
  });
  media.addEventListener('change', e => {
    if (!['light', 'dark'].includes(storedTheme() ?? '')) {
      document.documentElement.dataset.theme = e.matches ? 'dark' : 'light';
      update();
    }
  });
</script>
