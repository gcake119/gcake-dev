---
import { iconPaths } from './icon-paths';
interface Props { name: 'share' | 'book' | 'user' | 'sun' | 'moon' | 'search' | 'microphone' | 'threads' | 'instagram' | 'substack' | 'rss' | 'github' | 'mail'; }
const { name } = Astro.props;

---
<svg class={`icon icon--${name}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'user' && <circle cx="12" cy="8" r="4" />}
  {name === 'sun' && <circle cx="12" cy="12" r="4" />}
  {name === 'rss' && <circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none" />}
  {name === 'github' && <path d="M7.72 19.5c-3 .92-3-1.5-4-2" />}
  <path d={iconPaths[name]} />
</svg>
