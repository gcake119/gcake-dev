---
import { subscriptionLinks } from '@/data/site';
import Icon from './Icon.astro';

interface Props {
  compact?: boolean;
  ending?: boolean;
}
const { compact = false, ending = false } = Astro.props;
---

<section class:list={['subscription', { 'subscription--compact': compact, 'subscription--ending': ending }]} aria-labelledby="subscription-heading">
  <h2 id="subscription-heading">{ending ? '持續讀新的開發筆記' : compact ? '想繼續讀新的技術文章？' : '持續追蹤新的技術文章'}</h2>
  <p>{ending ? '透過電子報或 RSS，追蹤新的文章。' : '透過電子報或 RSS，追蹤新的開發筆記。'}</p>
  <div class="subscription__links">
    {subscriptionLinks.map(link => <a class="text-link" href={link.href}><Icon name={link.kind === 'newsletter' ? 'mail' : 'rss'} /><span>{link.label}</span><span aria-hidden="true">→</span></a>)}
  </div>
</section>

<style>
  .subscription { margin: 40px 0; padding: 24px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .subscription h2 { margin-bottom: 12px; }
  .subscription p { margin-bottom: 12px; color: var(--ink-soft); }
  .subscription__links { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 24px; }
  .subscription__links a { gap: 8px; }
  .subscription--compact { padding-bottom: 0; border-bottom: 0; }
  .subscription--compact h2 { font-size: 1.18rem; }
  .subscription--ending { margin: 0; padding: 26px 0 30px; border-bottom: 0; }
  .subscription--ending h2 { font-size: 1.18rem; line-height: 1.45; margin-bottom: 8px; }
  .subscription--ending p { margin-bottom: 0; }
  .subscription--ending .subscription__links { margin-top: 12px; }
</style>
