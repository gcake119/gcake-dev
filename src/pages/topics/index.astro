---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { isPublicPost } from '@/lib/content/publication';
import { getCollection } from 'astro:content';
import { localCanonical } from '@/lib/seo/canonical';
import { site } from '@/data/site';
import { loadTopicTaxonomy } from '@/lib/content/topics';
import { loadIthomeArticles } from '@/lib/content/external';

const local = (await getCollection('posts')).filter((post) => isPublicPost(post.data));
const external = loadIthomeArticles();
const used = new Set([
  ...local.flatMap((post) => post.data.topics),
  ...external.flatMap((post) => post.topics),
]);
const topics = (await loadTopicTaxonomy()).filter((topic) => used.has(topic.id));
---

<BaseLayout title="主題" canonical={localCanonical('/topics/')}>
  <header class="index-header"><p class="page-kicker">Topics</p><h1 class="page-title">主題</h1><p class="lede">跨文章與系列探索相同的工程問題。</p></header>
  {topics.length > 0 ? <ul class="topic-list">{topics.map((topic) => <li><a href={`${site.basePath}/topics/${topic.id}/`}>{topic.label}<small> {topic.labelEn}</small></a></li>)}</ul> : <p class="empty-state">文章發布後，相關主題會整理在這裡。</p>}
</BaseLayout>
