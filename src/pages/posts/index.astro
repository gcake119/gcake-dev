---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { localCanonical } from '@/lib/seo/canonical';

const posts = (await getCollection('posts'))
  .filter((post) => post.data.status === 'published')
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));
---
<BaseLayout title="文章" canonical={localCanonical('/posts/')}>
  <h1>文章</h1>
  {posts.length === 0 ? <p>尚未發布文章。</p> : (
    <ul>
      {posts.map((post) => (
        <li>
          <a href={`/gcake-dev/posts/${post.id}/`}>{post.data.title}</a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
