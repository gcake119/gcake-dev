---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SeriesNavigation from '@/components/SeriesNavigation.astro';
import { getCollection, render } from 'astro:content';
import { loadReadingCatalog } from '@/lib/content/catalog';
import { isPublishedDate } from '@/lib/content/publication';
import { localCanonical } from '@/lib/seo/canonical';
import { formatDate } from '@/lib/content/format';
import { site } from '@/data/site';
export async function getStaticPaths() {
  return (await getCollection('posts')).filter(p => p.data.status === 'published' && isPublishedDate(p.data.publishedAt)).map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const { series: allSeries } = await loadReadingCatalog();
const series = allSeries.find(s => s.slug === post.data.series);
const position = series?.articles.findIndex(p => p.slug === post.id) ?? -1;
const previous = position > 0 ? series?.articles[position - 1] : undefined;
const next = position >= 0 ? series?.articles[position + 1] : undefined;
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---
<BaseLayout title={post.data.title} description={post.data.description} canonical={localCanonical(`/posts/${post.id}/`)} mainClass="article-page">
  <article>
    <header class="article-header">
      {series && <><p class="article-breadcrumb"><a href={`${site.basePath}/series/${series.slug}/`}>{series.title}</a></p><SeriesNavigation series={series} current={post.id} /></>}
      <h1>{post.data.title}</h1>
      <div class="article-meta">{post.data.publishedAt && <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>}{post.data.topics.map(t => <a href={`${site.basePath}/topics/${encodeURIComponent(t)}/`}>{t}</a>)}</div>
    </header>
    {toc.length > 0 && <details class="reading-toc"><summary>本篇目錄</summary><ol>{toc.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></details>}
    <div class="prose"><Content /></div>
    {(previous || next) && <nav class="article-pagination" aria-label="系列文章導覽">{previous ? <a href={previous.href}><small>上一篇</small><strong>{previous.title}</strong></a> : <span />}{next && <a href={next.href}><small>下一篇</small><strong>{next.title}</strong></a>}</nav>}
    {series && <a class="text-link" href={`${site.basePath}/series/${series.slug}/`}>返回系列總覽 →</a>}
  </article>
</BaseLayout>
