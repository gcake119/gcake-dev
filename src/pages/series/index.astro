---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SeriesEntry from '@/components/SeriesEntry.astro';
import { loadReadingCatalog } from '@/lib/content/catalog';
import { localCanonical } from '@/lib/seo/canonical';
const { series } = await loadReadingCatalog();
const groups = [{ title: '連載中', items: series.filter(s => s.publicationState === 'active') }, { title: '其他系列', items: series.filter(s => s.publicationState !== 'active') }];
---
<BaseLayout title="全部系列" canonical={localCanonical('/series/')}>
  <header class="index-header"><h1 class="page-title">全部系列</h1><p class="lede">沿著一個問題，讀完整段思考。</p></header>
  {groups.map(g => g.items.length > 0 && <section class="index-group"><h2>{g.title}</h2>{g.items.map(s => <SeriesEntry series={s} />)}</section>)}
  {!series.length && <p class="empty-state">系列規劃尚未公開。</p>}
</BaseLayout>
