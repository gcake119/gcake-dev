---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadReadingCatalog } from '@/lib/content/catalog';
import { localCanonical } from '@/lib/seo/canonical';
import { formatDate } from '@/lib/content/format';
import { site } from '@/data/site';
export async function getStaticPaths() {
  const { series } = await loadReadingCatalog();
  return series.map(s => ({ params: { slug: s.slug }, props: { series: s } }));
}
const { series } = Astro.props;
const statusLabel = { active: '連載中', completed: '已完結', paused: '暫停連載' }[series.publicationState];
---
<BaseLayout title={series.title} description={series.description} canonical={localCanonical(`/series/${series.slug}/`)}>
  <header class="series-hero">
    <p class="series-label">{statusLabel}</p><h1 class="page-title">{series.title}</h1>
    {series.description && <p class="lede">{series.description}</p>}
    {series.firstDate && <p class="series-period">連載期間：{formatDate(series.firstDate)}{series.publicationState === 'active' ? ' 至今' : series.latestDate ? `～${formatDate(series.latestDate)}` : ''}</p>}
    <a class="primary-link" href={series.articles[0].href}>從第一篇開始 →</a>
  </header>
  <div class="chapter-list">{series.sections.filter(s => s.articles.length).map((section,i) => <section class="series-chapter" id={section.id}>
    <h2>第 {i+1} 章｜{section.title}</h2>{section.description && <p>{section.description}</p>}
    <ol class="chapter-posts">{section.articles.map(p => <li><a href={p.href}>{p.title}</a>{p.date && <time datetime={p.date.toISOString()}>{formatDate(p.date)}</time>}</li>)}</ol>
  </section>)}</div>
  {series.source?.type === 'external' && <p class="series-source"><a href={site.legacySeries.ithome2026.siteUrl}>前往原始系列 ↗</a></p>}
</BaseLayout>
