---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SeriesNavigation from '@/components/SeriesNavigation.astro';
import { loadIthomeArticles } from '@/lib/content/external';
import { loadReadingCatalog } from '@/lib/content/catalog';
import { formatDate } from '@/lib/content/format';
import { site } from '@/data/site';
export async function getStaticPaths() {
  return loadIthomeArticles().map(article => ({ params: { post: article.slug }, props: { article } }));
}
const { article } = Astro.props;
const { series: allSeries } = await loadReadingCatalog();
const series = allSeries.find(s => s.slug === 'ithome-2026')!;
const index = series.articles.findIndex(p => p.slug === article.slug);
const previous = series.articles[index - 1];
const next = series.articles[index + 1];
const toc = article.headings.filter(h => h.depth === 2 || h.depth === 3);
---
<BaseLayout title={article.title} description={article.description} canonical={article.canonicalUrl} mainClass="article-page">
  <article>
    <header class="article-header">
      <p class="article-breadcrumb"><a href={`${site.basePath}/series/${series.slug}/`}>{series.title}</a></p>
      <SeriesNavigation series={series} current={article.slug} />
      <h1>{article.title}</h1>
      <div class="article-meta">{article.publishedAt && <time datetime={article.publishedAt.toISOString()}>{formatDate(article.publishedAt)}</time>}<a href={article.canonicalUrl}>原始版本 ↗</a></div>
    </header>
    {toc.length > 0 && <details class="reading-toc"><summary>本篇目錄</summary><ol>{toc.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></details>}
    <div class="prose" set:html={article.html} />
    <nav class="article-pagination" aria-label="系列文章導覽">
      {previous ? <a href={previous.href}><small>上一篇</small><strong>{previous.title}</strong></a> : <span />}
      {next && <a href={next.href}><small>下一篇</small><strong>{next.title}</strong></a>}
    </nav>
    <a class="text-link" href={`${site.basePath}/series/${series.slug}/`}>返回系列總覽 →</a>
  </article>
</BaseLayout>
