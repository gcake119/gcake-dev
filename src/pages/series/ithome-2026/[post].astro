---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadIthomeArticles } from '@/lib/content/external';
import { getSeriesManifest } from '@/lib/content/series';
import { site } from '@/data/site';
import { formatDate } from '@/lib/content/format';

export async function getStaticPaths() {
  return loadIthomeArticles().map((article) => ({ params: { post: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const articles = loadIthomeArticles();
const series = await getSeriesManifest('ithome-2026');
const index = articles.findIndex((item) => item.slug === article.slug);
const previous = index > 0 ? articles[index - 1] : undefined;
const next = articles[index + 1];
const section = series?.sections.find((item) => item.posts.some((post) => post.slug === article.slug));
const sectionIndex = series && section ? series.sections.indexOf(section) : -1;
const sectionPostIndex = section ? section.posts.findIndex((item) => item.slug === article.slug) : -1;
const articleNumber = sectionIndex >= 0 && sectionPostIndex >= 0 ? `${sectionIndex + 1}-${sectionPostIndex + 1}` : `Day ${article.day}`;
const toc = article.headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const readingMinutes = Math.max(1, Math.ceil(article.body.length / 700));
---

<BaseLayout title={article.title} description={article.description} canonical={article.canonicalUrl} mainClass="article-page">
  <article>
    <header class="article-header">
      <p class="article-breadcrumb">典藏系列／2026 iThome 鐵人賽{section ? `／${section.title}` : ''}</p>
      <div class="article-heading-row">
        <span class="article-number" aria-label={`系列第 ${articleNumber} 篇`}>{articleNumber}</span>
        <div class="article-heading">
          <h1>{article.title}</h1>
          {article.description && <p>{article.description}</p>}
          <div class="article-meta">
            {article.publishedAt && <time datetime={article.publishedAt.toISOString()}>{formatDate(article.publishedAt)}</time>}
            <span>· 約 {readingMinutes} 分鐘</span><span>· 2026 iThome 鐵人賽</span>
          </div>
        </div>
        <aside class="article-series-context">
          <p>本系列第 {article.day} 篇，共 {articles.length} 篇</p>
          <a class="text-link" href={`${site.basePath}/series/ithome-2026/`}>查看系列目錄 →</a>
          <a class="external-source-link" href={article.canonicalUrl}>前往原始版本 ↗</a>
        </aside>
      </div>
    </header>

    <div class="article-layout">
      {toc.length > 0 && <aside class="article-toc" aria-label="本文目錄"><h2>本文目錄</h2><ol>{toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></aside>}
      {toc.length > 0 && <details class="article-toc-mobile"><summary>本文目錄（{toc.length}）</summary><ol>{toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></details>}
      <div class="prose" set:html={article.html} />
      <nav class="article-pagination" aria-label="典藏系列文章導覽">
        {previous ? <a href={`${site.basePath}/series/ithome-2026/${previous.slug}/`}><small>上一篇</small><strong>{previous.title}</strong></a> : <span />}
        {next && <a href={`${site.basePath}/series/ithome-2026/${next.slug}/`}><small>下一篇</small><strong>{next.title}</strong></a>}
      </nav>
    </div>
  </article>
</BaseLayout>
