---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SeriesEntry from '@/components/SeriesEntry.astro';
import { loadReadingCatalog } from '@/lib/content/catalog';
import { localCanonical } from '@/lib/seo/canonical';
import { site } from '@/data/site';
import { formatDate } from '@/lib/content/format';
const { series, posts } = await loadReadingCatalog();
const featured = series.slice(0, 3);
const active = featured.filter(s => s.publicationState === 'active');
const others = featured.filter(s => s.publicationState !== 'active');
---
<BaseLayout canonical={localCanonical('/')}>
  <header class="home-intro"><h1 class="display-title">{site.title}</h1><p class="lede">{site.tagline}</p></header>
  {active.length > 0 && <section class="home-section" aria-labelledby="active-heading"><h2 id="active-heading">連載中系列</h2>{active.map(s => <SeriesEntry series={s} />)}</section>}
  <section class="home-section latest-posts" aria-labelledby="latest-heading">
    <h2 id="latest-heading">最近文章</h2>
    {posts.length ? <ul class="recent-list">{posts.slice(0,3).map(p => <li>
      <h3><a href={p.href}>{p.title} →</a></h3>
      <p>{p.date && <time datetime={p.date.toISOString()}>{formatDate(p.date)}</time>}{p.series && <><span>・</span><a href={`${site.basePath}/series/${p.series}/`}>{series.find(s => s.slug === p.series)?.title}</a></>}</p>
    </li>)}</ul> : <p class="empty-state">文章正在整理中。</p>}
  </section>
  {others.length > 0 && <section class="home-section" aria-labelledby="other-heading"><h2 id="other-heading">{active.length ? '其他系列' : '系列文章'}</h2>{others.map(s => <SeriesEntry series={s} />)}</section>}
  <a class="text-link" href={`${site.basePath}/series/`}>查看全部系列 →</a>
</BaseLayout>
