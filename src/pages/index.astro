---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArchiveStrip from '@/components/ArchiveStrip.astro';
import { isPublishedDate } from '@/lib/content/publication';
import { getCollection } from 'astro:content';
import { loadSeriesManifests } from '@/lib/content/series';
import { localCanonical } from '@/lib/seo/canonical';
import { site } from '@/data/site';
import { formatDate } from '@/lib/content/format';

const posts = (await getCollection('posts'))
  .filter((post) => post.data.status === 'published' && isPublishedDate(post.data.publishedAt))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));
const allSeries = await loadSeriesManifests();
const currentSeries = allSeries.find((item) => item.status === 'active');
const localSeries = allSeries.filter((item) => ['active', 'completed'].includes(item.status));
const archivedSeries = allSeries.find((item) => item.status === 'archived');
const currentSeriesPosts = currentSeries
  ? currentSeries.sections.flatMap((section) => section.posts).filter((post) => post.status === 'published')
  : [];
const currentPostSlug = currentSeries?.editorial?.currentPost ?? currentSeriesPosts.at(-1)?.slug;
const currentPost = posts.find((post) => post.id === currentPostSlug);
const topics = [...new Set(posts.flatMap((post) => post.data.topics))].slice(0, 5);
const dateParts = new Intl.DateTimeFormat('zh-TW', { timeZone: 'Asia/Taipei', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date());
const datePart = (type: Intl.DateTimeFormatPartTypes) => dateParts.find((part) => part.type === type)?.value;
---

<BaseLayout canonical={localCanonical('/')}>
  <section class="home-intro">
    <p class="page-kicker">技術文章與學習紀錄</p>
    <h1 class="display-title">我在這裡記錄，自己如何逐步看懂一個系統</h1>
    <p class="lede">
      這是一個關於 AI 協作開發、系統理解、產品工作與工程學習的個人技術寫作空間。<br />
      我記錄實作過程中的思考、方法與經驗，也誠實面對自己的能力邊界，持續學習、持續整理。
    </p>
    <aside class="home-intro__date" aria-label="網站更新日期">
      <span>今天是</span><strong>{datePart('year')}</strong><span>{datePart('month')} / {datePart('day')}</span>
    </aside>
  </section>

  {currentSeries && (
    <section class="home-section" aria-labelledby="current-series-heading">
      <div class="home-section__header"><h2 id="current-series-heading">進行中的系列</h2></div>
      <div class="featured-series">
        <span class="editorial-number" aria-hidden="true">01</span>
        <div class="featured-series__body">
          <h2 class="section-title"><a href={`${site.basePath}/series/${currentSeries.slug}/`}>{currentSeries.title}</a></h2>
          {currentSeries.description && <p>{currentSeries.description}</p>}
          <p class="muted">{currentSeries.sections.length} 個章節 · 已發布 {currentSeriesPosts.length} 篇 · 持續更新</p>
          <a class="text-link" href={currentPost ? `${site.basePath}/posts/${currentPost.id}/` : `${site.basePath}/series/${currentSeries.slug}/`}>
            {currentPost ? '繼續閱讀最新一篇 →' : '查看系列目錄 →'}
          </a>
        </div>
        {currentPost && (
          <div class="featured-series__latest">
            <small>最新文章</small><strong>{currentPost.data.title}</strong>
            {currentPost.data.publishedAt && <time datetime={currentPost.data.publishedAt.toISOString()}>{formatDate(currentPost.data.publishedAt)}</time>}
          </div>
        )}
      </div>
    </section>
  )}

  <section class="home-section" aria-labelledby="latest-posts-heading">
    <div class="home-section__header">
      <h2 id="latest-posts-heading">最新文章</h2>
      {posts.length > 4 && <a href={`${site.basePath}/posts/`}>全部文章</a>}
    </div>
    {posts.length === 0 ? (
      <p class="empty-state">新的文章正在整理中。已完成的 2026 iThome 系列可以從下方典藏入口閱讀。</p>
    ) : (
      <ul class="post-list">
        {posts.slice(0, 4).map((post) => (
          <li class="post-row">
            {post.data.publishedAt && <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>}
            <div><h3><a href={`${site.basePath}/posts/${post.id}/`}>{post.data.title}</a></h3>{post.data.description && <p>{post.data.description}</p>}</div>
            <div class="post-row__topics">{post.data.topics.slice(0, 2).map((topic) => <span>{topic}</span>)}</div>
          </li>
        ))}
      </ul>
    )}
  </section>

  {localSeries.length > 0 && (
    <section class="home-section" aria-labelledby="series-heading">
      <div class="home-section__header"><h2 id="series-heading">系列</h2><a href={`${site.basePath}/series/`}>全部系列</a></div>
      <ol class="series-list">
        {localSeries.slice(0, 2).map((item, index) => {
          const count = item.sections.flatMap((section) => section.posts).filter((post) => post.status === 'published').length;
          return (
            <li class="series-entry">
              <span class="editorial-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div><h3><a href={`${site.basePath}/series/${item.slug}/`}>{item.title}</a></h3><p>{item.sections.length} 個章節 · 已發布 {count} 篇 · {item.status === 'completed' ? '已完結' : '持續更新'}</p>{item.description && <p>{item.description}</p>}</div>
            </li>
          );
        })}
      </ol>
    </section>
  )}

  {topics.length > 0 && (
    <section class="home-section" aria-labelledby="topics-heading">
      <div class="home-section__header"><h2 id="topics-heading">主題</h2></div>
      <ul class="topic-list">{topics.map((topic) => <li><a href={`${site.basePath}/topics/${encodeURIComponent(topic)}/`}>{topic}</a></li>)}</ul>
    </section>
  )}

  {archivedSeries && (
    <div class="home-section">
      <ArchiveStrip title="2026 iThome 鐵人賽" meta="30 篇 · 五章 · 已完結" href={`${site.basePath}/series/${archivedSeries.slug}/`} />
    </div>
  )}
</BaseLayout>
