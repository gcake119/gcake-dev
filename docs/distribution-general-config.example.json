{
  "substack": {
    "writeEnabled": false,
    "profile": "/outside/git/substack-profile",
    "ui": {
      "version": 1,
      "origin": "https://gcakedev.substack.com",
      "reviewedAt": "2026-10-11",
      "publishingCapabilitiesVerified": false,
      "discoveryVerified": false,
      "homePath": "/publish/home",
      "postsPath": "/publish/posts",
      "editPath": "/publish/post/{id}",
      "createMenu": {
        "role": "button",
        "name": "建立"
      },
      "create": {
        "role": "menuitem",
        "name": "文章"
      },
      "title": {
        "role": "textbox",
        "name": "title"
      },
      "body": {
        "role": "textbox",
        "name": "開始寫作……"
      },
      "saved": {
        "role": "button",
        "name": "已儲存"
      },
      "settings": {
        "role": "button",
        "name": "設定"
      },
      "continue": {
        "role": "button",
        "name": "繼續"
      },
      "email": {
        "role": "checkbox",
        "name": "透過電子郵件和 Substack App 傳送"
      },
      "confirmPublish": {
        "role": "button",
        "name": "立即發佈"
      },
      "draftLinks": "UNVERIFIED",
      "scanComplete": {
        "role": "tab",
        "name": "UNVERIFIED"
      },
      "publicBody": "div.body.markup",
      "publicTitle": "h1.post-title",
      "publicDate": "time[datetime]",
      "publicationPolicy": "full-mirror",
      "displayedDateFormat": "datetime-local",
      "displayedDateOffsetMinutes": 480,
      "displayedDatePrecision": "minute"
    }
  },
  "unattended": {
    "enabled": false,
    "scope": "all-formal-markdown",
    "repository": "gcake119/gcake-dev",
    "branch": "main",
    "policy": "pages-first-no-newsletter",
    "targets": [
      "substack"
    ]
  }
}
