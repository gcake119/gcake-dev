+        self.assertEqual(inspect_provider('',CHAT,forbidden)['network_requests'],0)
+        for method in ('sendMessage','getUpdates','setWebhook'):
+            with self.assertRaises(ValueError):read_method(TOKEN,method,{},forbidden)
